# Copy to backend/.env and fill in your own values. Never commit backend/.env.

# Port the API listens on (hosting platforms usually set this for you)
PORT=3000

# Frontend origin(s) allowed to call the API, comma-separated
CORS_ORIGIN=http://localhost:5173

# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI API key used by the backend
OPENAI_API_KEY=your-openai-api-key
