# Copy to frontend/.env and fill in your own values. Never commit frontend/.env.

# Base URL of the backend API (no trailing slash). Needed for local dev, where Vite and Express run
# on different ports. Leave it unset in production: the API is on the same site as the app.
VITE_API_URL=http://localhost:3000

# Show the "Save this job" option (stores resumes/results). Off unless set to true; see DECISIONS.md.
VITE_ENABLE_SAVED_JOBS=false

# Supabase project settings (Project Settings -> API); the anon key is safe to expose in the browser
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
